# AI Gateway uses Vercel OIDC in deployed environments; no provider API key is required.
# Set false only to use the built-in pre-launch fallback responses.
AI_GATEWAY_ENABLED="true"
# Optional Gateway model selection. Use provider/model format.
AI_GATEWAY_MODEL="openai/gpt-4o-mini"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Cash launch gate: keep false until counsel and operations approve launch.
CASH_LAUNCH_ENABLED="false"
LEGAL_REVIEW_APPROVAL_REFERENCE=""
OFFICIAL_RULES_URL=""
OFFICIAL_RULES_VERSION=""
PRIZE_FUND_ATTESTATION_REFERENCE=""
FUNDS_SAFEGUARDING_PROVIDER=""
FUNDS_SAFEGUARDING_ACCOUNT_REFERENCE=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_MEMBERSHIP_PRICE_ID=""

# Supplier trend digests: cron prepares email-ready payloads only; no email is sent until a delivery provider is configured.
CRON_SECRET=""
# Used only by a trusted server-side tracker; never expose this value in client code.
TREND_EVENT_WRITE_SECRET=""
MOSS_PRESTIGE_ALERT_EMAIL=""
VENO_CORP_GAMING_ALERT_EMAIL=""
LUXE_GAMING_BUNDLES_ALERT_EMAIL=""

# Company records register: bearer token protecting the CRUD API in api/company-records.
COMPANY_RECORDS_API_TOKEN=""
# Optional dedicated Neon database; falls back to ENTROPY_AUDIT_DATABASE_URL when unset.
COMPANY_RECORDS_DATABASE_URL=""

# Postal entry intake: bearer token for /api/postal-entries and the /postal-intake page.
POSTAL_ENTRIES_API_TOKEN=""

# Uploaded launch-build integration: separate durable review/control records only.
# Apply database/launch_build.sql to this database. No fallback to customer/entry data.
LAUNCH_BUILD_DATABASE_URL=""
# Dedicated server-side bearer token; never use a VITE_ prefix or commit its value.
LAUNCH_BUILD_ADMIN_TOKEN=""
