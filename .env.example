# AI Gateway uses Vercel OIDC in deployed environments; no provider API key is required.
# Set false only to use the built-in pre-launch fallback responses.
AI_GATEWAY_ENABLED="true"
# Optional Gateway model selection. Use provider/model format.
AI_GATEWAY_MODEL="openai/gpt-4o-mini"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Cash launch gate: keep false until counsel and operations approve launch.
CASH_LAUNCH_ENABLED="false"
LEGAL_REVIEW_APPROVAL_REFERENCE=""
OFFICIAL_RULES_URL=""
OFFICIAL_RULES_VERSION=""
PRIZE_FUND_ATTESTATION_REFERENCE=""
FUNDS_SAFEGUARDING_PROVIDER=""
FUNDS_SAFEGUARDING_ACCOUNT_REFERENCE=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_MEMBERSHIP_PRICE_ID=""

# Supplier trend digests: cron prepares email-ready payloads only; no email is sent until a delivery provider is configured.
CRON_SECRET=""
# Used only by a trusted server-side tracker; never expose this value in client code.
TREND_EVENT_WRITE_SECRET=""
MOSS_PRESTIGE_ALERT_EMAIL=""
VENO_CORP_GAMING_ALERT_EMAIL=""
LUXE_GAMING_BUNDLES_ALERT_EMAIL=""

# Company-record API: a server-only bearer token for /api/companies.
COMPANY_RECORDS_ADMIN_SECRET=""
