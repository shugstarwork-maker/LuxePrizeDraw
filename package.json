{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "npm run build && node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:games": "node --import tsx --test tests/rules.test.ts",
    "test:compliance": "node --import tsx --test tests/prizeDrawCompliance.test.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:ticket-db": "node tests/integration/automaticTicketDraw.mjs",
    "verify": "npm run lint && npm test && npm run test:ticket-db && npm run build"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@upstash/redis": "^1.38.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "ai": "^7.0.107",
    "canvas-confetti": "^1.9.4",
    "chess.js": "^1.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tesseract.js": "^7.0.0",
    "vite": "^6.2.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20 <23"
  }
}
